{
  "compilerOptions": {
    "strict": true, "module": "commonjs", "moduleResolution": "node",
    "target": "es2019", "lib": ["es2019", "es2020", "es2022.error"],
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true,
    "noUnusedLocals": true, "noImplicitReturns": true, "declaration": true,
    "sourceMap": true, "outDir": "dist"
  },
  "include": ["credentials/**/*", "nodes/**/*"]
}
